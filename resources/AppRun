#!/bin/bash
SELF=$(readlink -f "$0")
HERE=${SELF%/*}

# Debug mode - set to 1 to see environment setup
DEBUG=${LUMIXOR_DEBUG:-0}

if [ "$DEBUG" = "1" ]; then
    echo "=== Lumixor AppImage Debug ==="
    echo "HERE: $HERE"
fi

# Library paths - bundled libraries MUST come first to avoid system conflicts
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/lib:${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Executable paths
export PATH="${HERE}/usr/bin:${HERE}/bin:${PATH:+:$PATH}"

# Qt plugin paths - check multiple possible locations
export QT_PLUGIN_PATH="${HERE}/usr/plugins:${HERE}/usr/lib/qt5/plugins"

# QML import paths
export QML2_IMPORT_PATH="${HERE}/usr/qml:${HERE}/usr/lib/qml"

# Qt platform plugin path
export QT_QPA_PLATFORM_PLUGIN_PATH="${HERE}/usr/plugins/platforms"

# Qt directory
export QTDIR="${HERE}/usr"

# XDG data dirs
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# GStreamer - use SYSTEM plugins, not bundled ones (more reliable)
# The bundled GStreamer often has compatibility issues
unset GST_PLUGIN_PATH
unset GST_PLUGIN_SYSTEM_PATH
unset GST_PLUGIN_SYSTEM_PATH_1_0
unset GST_PLUGIN_SCANNER

# Font configuration - use system fonts
export FONTCONFIG_PATH=/etc/fonts
export FONTCONFIG_FILE=/etc/fonts/fonts.conf

# Scaling
export QT_ENABLE_HIGHDPI_SCALING=1

if [ "$DEBUG" = "1" ]; then
    echo "LD_LIBRARY_PATH: $LD_LIBRARY_PATH"
    echo "QT_PLUGIN_PATH: $QT_PLUGIN_PATH"
    echo "QML2_IMPORT_PATH: $QML2_IMPORT_PATH"
    echo ""
    echo "Checking mediaservice plugins:"
    ls -la "${HERE}/usr/plugins/mediaservice/" 2>/dev/null || echo "No mediaservice dir"
    echo ""
    echo "Checking for libqgsttools:"
    find "${HERE}" -name "*gsttools*" 2>/dev/null
    echo "=== End Debug ==="
fi

cd "${HERE}/usr"
exec "${HERE}/usr/bin/lumixor-qt" "$@"