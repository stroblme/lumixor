#!/bin/bash
SELF=$(readlink -f "$0")
HERE=${SELF%/*}

# Debug mode - set to 1 to see environment setup
DEBUG=${LUMIXOR_DEBUG:-0}

if [ "$DEBUG" = "1" ]; then
    echo "=== Lumixor AppImage Debug ==="
    echo "HERE: $HERE"
fi

# Library paths - bundled libraries MUST come first to avoid system conflicts
# BUT we need to exclude GStreamer libraries to avoid version mismatches
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/lib:${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Executable paths
export PATH="${HERE}/usr/bin:${HERE}/bin:${PATH:+:$PATH}"

# GStreamer - Use system entirely, no bundling
# Unset any plugin paths to use system defaults
unset GST_PLUGIN_PATH
unset GST_PLUGIN_SYSTEM_PATH
unset GST_PLUGIN_SYSTEM_PATH_1_0
unset GST_PLUGIN_SCANNER

# Qt plugin paths - prefer system Qt multimedia plugins to use system GStreamer
export QT_PLUGIN_PATH="/usr/lib/x86_64-linux-gnu/qt5/plugins:${HERE}/usr/plugins:${HERE}/usr/lib/qt5/plugins"

# QML import paths
export QML2_IMPORT_PATH="${HERE}/usr/qml:${HERE}/usr/lib/qml"

# Qt platform plugin path
export QT_QPA_PLATFORM_PLUGIN_PATH="${HERE}/usr/plugins/platforms"

# Qt directory
export QTDIR="${HERE}/usr"

# XDG data dirs
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# IMPORTANT: Also use system Qt multimedia plugins if bundled ones are missing
# This allows video playback to work if the target system has Qt5 multimedia installed
if [ ! -f "${HERE}/usr/plugins/mediaservice/libgstmediaplayer.so" ]; then
    # Add system Qt plugin paths as fallback
    export QT_PLUGIN_PATH="${HERE}/usr/plugins:/usr/lib/x86_64-linux-gnu/qt5/plugins:${HERE}/usr/lib/qt5/plugins"
fi

# CRITICAL FIX: The bundled mediaservice plugins are built against Ubuntu 22.04's
# GStreamer version. If there's a version mismatch, we need to use system plugins.
# Check if system Qt multimedia plugins exist and prefer them to avoid GStreamer conflicts
if [ -f "/usr/lib/x86_64-linux-gnu/qt5/plugins/mediaservice/libgstmediaplayer.so" ]; then
    # System has Qt multimedia plugins - use them instead of bundled ones
    # This avoids GStreamer version mismatches
    export QT_PLUGIN_PATH="/usr/lib/x86_64-linux-gnu/qt5/plugins:${HERE}/usr/plugins:${HERE}/usr/lib/qt5/plugins"
fi

# Font configuration - use system fonts
export FONTCONFIG_PATH=/etc/fonts
export FONTCONFIG_FILE=/etc/fonts/fonts.conf

# Scaling
export QT_ENABLE_HIGHDPI_SCALING=1

# Use XDG Desktop Portal for native file dialogs (works on GNOME, KDE, etc.)
# This is the modern way to get native dialogs in sandboxed/AppImage apps
export QT_QPA_PLATFORMTHEME=${QT_QPA_PLATFORMTHEME:-xdgdesktopportal}

# Fallback: try GTK3 theme if portal isn't available
if [ ! -S "${XDG_RUNTIME_DIR}/bus" ] && [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    export QT_QPA_PLATFORMTHEME=gtk3
fi

# DBus is required for portal dialogs
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    if [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
    fi
fi

if [ "$DEBUG" = "1" ]; then
    echo "=== Lumixor AppImage Debug Info ==="
    echo "Script Location: $SELF"
    echo "Executable Directory: $HERE"
    echo "LD_LIBRARY_PATH: $LD_LIBRARY_PATH"
    echo "GST_PLUGIN_PATH: $GST_PLUGIN_PATH"
    echo "QT_PLUGIN_PATH: $QT_PLUGIN_PATH"
    echo "QML2_IMPORT_PATH: $QML2_IMPORT_PATH"
    echo "QT_QPA_PLATFORM_PLUGIN_PATH: $QT_QPA_PLATFORM_PLUGIN_PATH"
    echo "QTDIR: $QTDIR"
    echo "XDG_DATA_DIRS: $XDG_DATA_DIRS"
    echo "DBUS_SESSION_BUS_ADDRESS: $DBUS_SESSION_BUS_ADDRESS"
    echo ""
    echo "Checking platform theme plugins:"
    ls -la "${HERE}/usr/plugins/platformthemes/" 2>/dev/null || echo "No platformthemes dir"
    echo ""
    echo "Checking mediaservice plugins:"
    ls -la "${HERE}/usr/plugins/mediaservice/" 2>/dev/null || echo "No mediaservice dir"
    echo ""
    echo "Checking for libqgsttools:"
    find "${HERE}" -name "*gsttools*" 2>/dev/null
    echo "=== End Debug ==="
fi

cd "${HERE}/usr"
exec "${HERE}/usr/bin/lumixor-qt" "$@"