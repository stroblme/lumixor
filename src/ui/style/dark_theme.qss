/* Global dark look */
QWidget {
    font-family: "Roboto", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 10pt;
    color: #E0E0E0;
    background-color: #121212;
    selection-background-color: #3949AB;
    selection-color: #FFFFFF;
}

QMainWindow {
    background-color: #121212;
}

/* List widget */
QListWidget {
    background-color: #1E1E1E;
    border-radius: 4px;
    border: 1px solid #333333;
    padding: 4px;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: #3949AB;
    color: #FFFFFF;
}

/* Buttons */
QPushButton {
    background-color: #1E88E5;
    border-radius: 4px;
    padding: 6px 12px;
    border: none;
    color: #FFFFFF;
}

QPushButton:hover {
    background-color: #42A5F5;
}

QPushButton:pressed {
    background-color: #1565C0;
}

QPushButton:disabled {
    background-color: #424242;
    color: #9E9E9E;
}

/* Status label */
#statusLabel {
    color: #B0BEC5;
}

/* MEDIA AREAS: pure black background */
QVideoWidget,
#imageLabel {
    background-color: #000000;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #555555;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #1E1E1E;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}