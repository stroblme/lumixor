/* Global dark look, touch friendly */
QWidget {
    font-family: "Roboto", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 11pt;                 /* slightly larger */
    color: #E0E0E0;
    background-color: #121212;
}

/* Main window background */
QMainWindow {
    background-color: #121212;
}

/* List widget (playlist) */
QListWidget {
    background-color: #1E1E1E;
    border-radius: 8px;              /* more rounded */
    border: 1px solid #333333;
    padding: 6px;
}

QListWidget::item {
    padding: 10px 12px;              /* bigger hit area */
}

QListWidget::item:selected {
    background-color: #3949AB;
    color: #FFFFFF;
}

/* Buttons: pill-shaped, larger padding */
QPushButton {
    background-color: #1E88E5;
    border-radius: 18px;             /* pill style */
    padding: 10px 18px;              /* more padding */
    border: none;
    color: #FFFFFF;
    min-height: 34px;                /* minimum touch size */
}

QPushButton:hover {
    background-color: #42A5F5;
}

QPushButton:pressed {
    background-color: #1565C0;
}

QPushButton:disabled {
    background-color: #424242;
    color: #9E9E9E;
}

/* SpinBox (for slideshow seconds) */
QSpinBox {
    background-color: #1E1E1E;
    border-radius: 12px;
    border: 1px solid #333333;
    padding: 6px 10px;
    min-height: 30px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 18px;
}

/* Labels */
QLabel {
    background-color: transparent;
}

/* Status label */
#statusLabel {
    color: #B0BEC5;
    padding: 6px;
}

/* MEDIA AREAS: pure black background */
QVideoWidget,
#imageLabel {
    background-color: #000000;
}

/* Scrollbars - thicker and rounded, easier to grab */
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #555555;
    min-height: 30px;
    border-radius: 7px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #1E1E1E;
    height: 14px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 30px;
    border-radius: 7px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

